{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "assets/**",
      "scripts/**",
      "test/**",
      "**/*.md",
      "!**/node_modules",
      "!public",
      "!resources",
      "!.git",
      "!.impact"
    ]
  },
  "markdown": {
    "parser": { "frontmatter": true },
    "formatter": { "enabled": false, "formatEmbeds": false },
    "linter": { "enabled": true }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnknownMediaFeatureName": "off",
        "noUnknownTypeSelector": "off"
      },
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["layouts/**"],
      "formatter": { "enabled": false }
    },
    {
      "includes": ["assets/jsconfig.json"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    }
  ],
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "quoteStyle": "single"
    }
  }
}
