{
  "name": "goblindegook.com",
  "repository": "github:goblindegook/goblindegook.com",
  "author": "Luis Rodrigues <hello@goblindegook.com>",
  "license": "CC-BY-NC-4.0",
  "private": true,
  "scripts": {
    "build": "npm run build:site && npm run build:search",
    "build:preview": "hugo --gc --minify --buildDrafts --buildFuture && npm run build:search",
    "build:search": "node scripts/search-index.mjs",
    "build:site": "hugo --gc --minify",
    "build:watch": "hugo serve --watch --buildDrafts --buildFuture",
    "format": "biome check --write .",
    "lint": "biome check .",
    "watch": "concurrently 'npm run test:watch' 'npm run build:watch'",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@testing-library/dom": "^10.4.2",
    "@types/estimate": "^1.0.3",
    "@types/webfontloader": "^1.6.38",
    "autoprefixer": "^10.6.2",
    "caniuse-lite": "^1.0.30001826",
    "concurrently": "^10.0.7",
    "css-modularscale": "^1.1.1",
    "cssnano": "^9.9.0",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "html-entities": "^2.6.0",
    "jsdom": "^31.0.0",
    "msw": "^3.0.5",
    "pixrem": "^5.0.0",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.1",
    "postcss-preset-env": "^11.6.2",
    "stopwords-en": "^0.3.0",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@pacote/signature-search": "^0.2.0",
    "animate.css": "^4.1.1",
    "colcade": "^0.2.0",
    "estimate": "^1.0.0",
    "littlefoot": "^4.1.4",
    "normalize.css": "^8.0.1",
    "smartypants": "^0.2.2",
    "snarkdown": "^2.0.0",
    "stemmer": "^2.0.1",
    "vanjs-core": "^1.6.2",
    "webfontloader": "^1.6.28"
  }
}