{
  "name": "goblindegook.com",
  "repository": "github:goblindegook/goblindegook.com",
  "author": "Luis Rodrigues <hello@goblindegook.com>",
  "license": "CC-BY-NC-4.0",
  "private": true,
  "scripts": {
    "build": "npm run build:site && npm run build:search",
    "build:preview": "hugo --gc --minify --buildDrafts --buildFuture && npm run build:search",
    "build:search": "node scripts/search-index.mjs",
    "build:site": "hugo --gc --minify",
    "format": "biome check --write assets/** scripts/** test/**",
    "lint": "biome check assets/** scripts/** test/**",
    "watch": "concurrently 'npm test' 'hugo serve --buildDrafts --buildFuture'",
    "test": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "@types/estimate": "^1.0.3",
    "@types/webfontloader": "^1.6.38",
    "autoprefixer": "^10.5.2",
    "caniuse-lite": "^1.0.30001752",
    "concurrently": "^9.2.5",
    "css-modularscale": "^1.1.1",
    "cssnano": "^7.1.7",
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.0",
    "html-entities": "^2.0.3",
    "jsdom": "^29.1.1",
    "pixrem": "^5.0.0",
    "postcss": "^8.5.23",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^11.2.1",
    "stopwords-en": "^0.3.0",
    "tslib": "^2.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@pacote/signature-search": "^0.2.0",
    "animate.css": "^4.1.0",
    "colcade": "^0.2.0",
    "estimate": "^1.0.0",
    "littlefoot": "^4.1.4",
    "normalize.css": "^8.0.0",
    "smartypants": "^0.1.1",
    "snarkdown": "^2.0.0",
    "stemmer": "^2.0.0",
    "vanjs-core": "^1.6.0",
    "webfontloader": "^1.6.28"
  }
}